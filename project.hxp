package; // FIXED: Must be lowercase

import hxp.*;
import lime.tools.*;
import sys.FileSystem;
import sys.io.File;
import haxe.io.Bytes;
import haxe.io.Path;
import haxe.ds.Map;
import haxe.xml.Printer;

using StringTools;
using tools.AnsiUtil;

@:nullSafety
class Project extends HXProject
{
  // --- METADATA ---
  static final VERSION:String = "0.8.3";
  static final BUILD_NUMBER:Int = 77;
  static final TITLE:String = "Friday Night Funkin' V-Slice";
  static final TITLE_MOBILE:String = "FNF V-Slice";
  static final PACKAGE_NAME:String = "com.arcel.vslice.mobile";
  static final EXECUTABLE_NAME:String = "Funkin";
  static final SOURCE_DIR:String = "source";
  static final MAIN_CLASS:String = "Main";
  static final COMPANY:String = "The Funkin' Crew";

  // --- MOBILE METADATA ---
  static final ANDROID_MINIMUM_SDK_VERSION:Int = 26; // Android 8.0+
  static final ANDROID_TARGET_SDK_VERSION:Int = 34; // Modern target

  public function new()
  {
    super();

    // App Setup
    meta.title = isMobile() ? TITLE_MOBILE : TITLE;
    meta.version = VERSION;
    meta.packageName = PACKAGE_NAME;
    meta.company = COMPANY;
    meta.buildNumber = Std.string(BUILD_NUMBER);

    app.main = MAIN_CLASS;
    app.file = EXECUTABLE_NAME;
    app.path = "export";

    sources.push(SOURCE_DIR);

    // Platform Logic
    if (isAndroid())
    {
      config.set("android.min-sdk-version", Std.string(ANDROID_MINIMUM_SDK_VERSION));
      config.set("android.target-sdk-version", Std.string(ANDROID_TARGET_SDK_VERSION));
      config.set("android.install-location", "auto");
    }

    // Required Libraries
    setupLibraries();
  }

  function setupLibraries()
  {
    lib.push({ name: "flixel", version: "5.5.0" });
    lib.push({ name: "flixel-addons" });
    lib.push({ name: "flixel-ui" });
    lib.push({ name: "hscript-iris" });
    lib.push({ name: "funkin.vis" });
    lib.push({ name: "hxvlc" });
    lib.push({ name: "extension-androidtools" });
    lib.push({ name: "polymod" });
  }
}
